# Copy to .env and adjust. All variables are optional; defaults are shown.
# Paths are relative to the working directory or absolute.

CREDIT_DATA_PATH=data/raw/credit_records.csv
CREDIT_MODEL_DIR=models
CREDIT_REPORTS_DIR=reports
CREDIT_PARAMS_PATH=config/model_params.toml

# Model served by the API and trained by default: knn | xgboost | random_forest
CREDIT_MODEL_NAME=xgboost
# group = no customer appears in both train and test (recommended); row = original notebook split
CREDIT_SPLIT_STRATEGY=group
CREDIT_TEST_SIZE=0.2
CREDIT_RANDOM_STATE=108

CREDIT_API_MAX_BATCH_SIZE=1000
CREDIT_LOG_LEVEL=INFO
